<Window x:Class="Jinky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Jinky"
        Title="Jinky" Width="1040" Height="800" MinWidth="800" MinHeight="600"
        Background="{StaticResource Ground}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Body}" FontSize="14" FontWeight="Medium"
        Icon="Assets/tile-256.png" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <!-- A faint blue glow behind the header, like the TV's home -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.7" RadiusY="0.55">
                    <GradientStop Color="#262856D9" Offset="0"/>
                    <GradientStop Color="#002856D9" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="36,26,36,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: logo + wordmark + version, status pill and update on the right -->
                <DockPanel Grid.Row="0" Margin="0,0,0,26" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Image Source="Assets/tile-256.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image Source="Assets/wordmark-white.png" Height="25" Margin="14,0,0,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="11" Padding="9,3" Margin="14,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionText}" FontFamily="{StaticResource Mono}" FontSize="11"
                                       Foreground="{StaticResource Muted}"/>
                        </Border>
                    </StackPanel>
                    <!-- Update available: one click downloads, verifies and installs it. -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                            Content="{Binding UpdateButtonText}" IsEnabled="{Binding CanInstallUpdate}" Click="Update_Click"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding UpdateNotes}"/>
                    <Border DockPanel.Dock="Right" CornerRadius="17" Padding="14,8" VerticalAlignment="Center" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Current}" Value="{x:Static local:MainViewModel+State.Streaming}">
                                        <Setter Property="Background" Value="{StaticResource GoodBg}"/>
                                        <Setter Property="BorderBrush" Value="#1F5A43"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Current}" Value="{x:Static local:MainViewModel+State.Failed}">
                                        <Setter Property="Background" Value="{StaticResource WarnBg}"/>
                                        <Setter Property="BorderBrush" Value="#5A4520"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="7" Height="7" VerticalAlignment="Center" Margin="0,1,9,0">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Current}" Value="{x:Static local:MainViewModel+State.Streaming}">
                                                <Setter Property="Fill" Value="{StaticResource Good}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Current}" Value="{x:Static local:MainViewModel+State.Failed}">
                                                <Setter Property="Fill" Value="{StaticResource Warn}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <TextBlock Text="{Binding PillText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Soft}"/>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!-- Pairing request: a new TV shows a code; the user approves it here if it matches -->
                <Border Grid.Row="1" CornerRadius="20" Padding="26" Margin="0,0,0,20" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                        Visibility="{Binding HasPairing, Converter={StaticResource BoolToVisibility}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1C2F66" Offset="0"/>
                            <GradientStop Color="#10141F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="NOVA TV" Style="{StaticResource Eyebrow}" Foreground="{StaticResource AccentSoft}"/>
                            <TextBlock FontFamily="{StaticResource Display}" FontSize="22" FontWeight="ExtraBold" TextWrapping="Wrap" Margin="0,6,0,0">
                                <Run Text="{Binding Pairing.Name, Mode=OneWay}"/><Run Text=" quer se conectar"/>
                            </TextBlock>
                            <TextBlock Text="Confira se a TV mostra o mesmo código. Só é preciso fazer isso uma vez."
                                       Style="{StaticResource Hint}" FontSize="13.5" Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding PairingCode}" FontFamily="{StaticResource Mono}" FontSize="40" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Recusar" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Padding="20,11" Click="RejectPairing_Click"/>
                            <Button Content="Permitir" Style="{StaticResource PrimaryButton}" Click="AcceptPairing_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Hero: what is happening now + live numbers -->
                <Border Grid.Row="2" CornerRadius="24" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,20" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#16234A" Offset="0"/>
                            <GradientStop Color="#10141F" Offset="0.62"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- The brand's pixels, scattered in the corner -->
                        <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="150" Height="90" Margin="0,22,26,0" IsHitTestVisible="False">
                            <Rectangle Canvas.Left="118" Canvas.Top="0" Width="14" Height="14" Fill="{StaticResource Accent}"/>
                            <Rectangle Canvas.Left="92" Canvas.Top="26" Width="10" Height="10" Fill="{StaticResource Accent}" Opacity="0.5"/>
                            <Rectangle Canvas.Left="136" Canvas.Top="40" Width="8" Height="8" Fill="{StaticResource Accent}" Opacity="0.3"/>
                            <Rectangle Canvas.Left="64" Canvas.Top="6" Width="6" Height="6" Fill="{StaticResource Accent}" Opacity="0.22"/>
                        </Canvas>
                        <StackPanel Margin="30,28,30,28">
                            <TextBlock Text="AGORA" Style="{StaticResource Eyebrow}" Foreground="{StaticResource AccentSoft}"/>
                            <TextBlock Text="{Binding StatusTitle}" FontFamily="{StaticResource Display}" FontSize="32" FontWeight="ExtraBold"
                                       Margin="0,8,170,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Muted}" FontSize="14.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <UniformGrid Columns="4" Margin="0,24,-10,0">
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="LATÊNCIA" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="{Binding Latency}" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="IMAGEM" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="{Binding Fps}" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="VÍDEO" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="{Binding Bitrate}" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="CODEC" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="{Binding Codec}" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Preferences + this PC -->
                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <HeaderedContentControl Header="Ao conectar a TV" Style="{StaticResource CardTitle}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ConsoleMode}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Modo console" FontWeight="Bold"/>
                                    <TextBlock Text="Abre o Steam Big Picture e põe o monitor em 60 Hz. Tudo volta ao normal quando você sai."
                                               Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CapGames}" IsEnabled="{Binding ConsoleMode}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Limitar jogos a 60 fps" FontWeight="Bold"/>
                                    <TextBlock Text="A TV mostra 60 quadros por segundo: o resto só ocupa a placa de vídeo e faz a imagem engasgar. Usa o limite do driver da NVIDIA e volta ao seu ajuste quando você sai."
                                               Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SoundOnlyOnTv}" IsEnabled="{Binding SoundToggleEnabled}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Som só na TV" FontWeight="Bold"/>
                                    <TextBlock Text="Silencia as caixas do PC enquanto a TV joga." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}">
                                <StackPanel>
                                    <TextBlock Text="Iniciar com o Windows" FontWeight="Bold"/>
                                    <TextBlock Text="O Jinky fica perto do relógio, sempre pronto para a TV." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <HeaderedContentControl Header="Este PC" Style="{StaticResource CardTitle}"/>
                            <Grid TextBlock.FontSize="13.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Placa de vídeo" Foreground="{StaticResource Muted}" Margin="0,0,16,10"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Gpu}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Tela capturada" Foreground="{StaticResource Muted}" Margin="0,0,16,10"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Desktop}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource Mono}" FontSize="12.5"/>
                                <TextBlock Grid.Row="2" Text="Controle virtual" Foreground="{StaticResource Muted}" Margin="0,0,16,10"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GamepadDriver}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="3" Text="Controles conectados" Foreground="{StaticResource Muted}" Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PadsConnected}" HorizontalAlignment="Right"
                                           FontFamily="{StaticResource Mono}" FontSize="12.5"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,18,0,16"/>
                            <TextBlock Text="BIBLIOTECA DA STEAM NA TV" Style="{StaticResource Eyebrow}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SteamDirect}" Margin="0,10,0,12">
                                <StackPanel>
                                    <TextBlock Text="Ler direto da Steam" FontWeight="Bold"/>
                                    <TextBlock Text="A TV mostra exatamente a sua biblioteca da Steam (seus jogos e os da família). Vale depois de reiniciar a Steam."
                                               Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Chave da API da Steam (steamcommunity.com/dev/apikey): conquistas, perfil e a biblioteca sem a leitura direta."/>
                            <TextBox Style="{StaticResource Field}" Margin="0,10,0,8"
                                     Text="{Binding SteamApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding SteamKeyStatus}" Foreground="{StaticResource Dim}" TextWrapping="Wrap" FontSize="12"/>
                            <!-- Only on the developer's PC (a "developer" file in Jinky's data folder). -->
                            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,18,0,16"
                                       Visibility="{Binding ShowTestUpdates, Converter={StaticResource BoolToVisibility}}"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TestUpdates}"
                                      Visibility="{Binding ShowTestUpdates, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Receber versões de teste" FontWeight="Bold"/>
                                    <TextBlock Text="Este PC (e as TVs dele) recebe as versões novas antes de todo mundo, para testar. Podem ter problemas."
                                               Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Paired TVs -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <HeaderedContentControl Header="TVs pareadas" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Nenhuma ainda. Abra o Jinky na TV: ela vai mostrar um código para você confirmar aqui."
                                   Style="{StaticResource Hint}" FontSize="13.5"
                                   Visibility="{Binding NoPairedTvs, Converter={StaticResource BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding PairedTvs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Raised}" CornerRadius="14" Padding="12,10,10,10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Button Content="Remover" Style="{StaticResource GhostButton}" DockPanel.Dock="Right"
                                                    Background="{StaticResource Surface}" Tag="{Binding Id}" Click="Unpair_Click"/>
                                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Surface}" Margin="0,0,14,0">
                                                <Path Data="M1,1 H19 V13 H1 Z M6,17 H14" Stroke="{StaticResource AccentSoft}" StrokeThickness="1.6"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- First install on a TV: the app is served by this PC on the home network. -->
                        <Border Background="{StaticResource Ground}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="14" Padding="16,14" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="INSTALAR NUMA TV NOVA" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,8"
                                           Text="Fire TV: instale o app Downloader e digite o endereço abaixo. Google TV (TCL e outras): ative &quot;Fontes desconhecidas&quot; e abra o endereço num navegador da TV. Depois disso, a TV se atualiza sozinha por este PC."/>
                                <TextBox Text="{Binding TvInstallUrl, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Field}"
                                         FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Activity -->
                <Border Grid.Row="5" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <HeaderedContentControl Header="Atividade" Style="{StaticResource CardTitle}" DockPanel.Dock="Left"/>
                            <Button Content="Abrir pasta de diagnóstico" Style="{StaticResource GhostButton}" DockPanel.Dock="Right"
                                    Click="OpenLogs_Click" VerticalAlignment="Top" Margin="0,-6,0,0"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5">
                                        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Dim}"
                                                   Width="58" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Soft}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
