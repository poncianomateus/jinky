<Window x:Class="Jinky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Jinky"
        Title="Jinky" Width="1000" Height="680" MinWidth="780" MinHeight="560"
        Background="{StaticResource Ground}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Body}" FontSize="14"
        Icon="Assets/mark-256.png" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: brand + status pill -->
            <DockPanel Grid.Row="0" Margin="0,0,0,22" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="Assets/mark-256.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Jinky" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="SemiBold"
                               Margin="12,0,0,2" VerticalAlignment="Center"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="12,6" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#14233A"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current}" Value="{x:Static local:MainViewModel+State.Streaming}">
                                    <Setter Property="Background" Value="{StaticResource GoodBg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Current}" Value="{x:Static local:MainViewModel+State.Failed}">
                                    <Setter Property="Background" Value="#2E2410"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Current}" Value="{x:Static local:MainViewModel+State.Streaming}">
                                            <Setter Property="Fill" Value="{StaticResource Good}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Current}" Value="{x:Static local:MainViewModel+State.Failed}">
                                            <Setter Property="Fill" Value="{StaticResource Warn}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding PillText}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Hero: what is happening now + live numbers -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="26" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="{Binding StatusTitle}" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Tile}" Width="112">
                            <StackPanel>
                                <TextBlock Text="Latência" Foreground="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock Text="{Binding Latency}" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" Width="112">
                            <StackPanel>
                                <TextBlock Text="Imagem" Foreground="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock Text="{Binding Fps}" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" Width="128">
                            <StackPanel>
                                <TextBlock Text="Vídeo" Foreground="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock Text="{Binding Bitrate}" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" Width="100" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Codec" Foreground="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock Text="{Binding Codec}" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Preferences + this PC -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ao conectar a TV" Style="{StaticResource CardTitle}"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ConsoleMode}" Margin="0,4,0,14">
                            <StackPanel>
                                <TextBlock Text="Modo console" FontWeight="SemiBold"/>
                                <TextBlock Text="Abre o Steam Big Picture e põe o monitor em 60 Hz. Tudo volta ao normal quando você sai."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SoundOnlyOnTv}" IsEnabled="{Binding SoundToggleEnabled}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Som só na TV" FontWeight="SemiBold"/>
                                <TextBlock Text="Silencia as caixas do PC enquanto a TV joga." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}">
                            <StackPanel>
                                <TextBlock Text="Iniciar com o Windows" FontWeight="SemiBold"/>
                                <TextBlock Text="O Jinky fica perto do relógio, sempre pronto para a TV." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Este PC" Style="{StaticResource CardTitle}"/>
                        <DockPanel Margin="0,4,0,10"><TextBlock Text="Placa de vídeo" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Gpu}" HorizontalAlignment="Right"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Tela capturada" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Desktop}" HorizontalAlignment="Right"/></DockPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Controle virtual" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding GamepadDriver}" HorizontalAlignment="Right"/></DockPanel>
                        <DockPanel><TextBlock Text="Controles conectados" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding PadsConnected}" HorizontalAlignment="Right"/></DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Activity -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Atividade" Style="{StaticResource CardTitle}" DockPanel.Dock="Left"/>
                        <Button Content="Abrir pasta de diagnóstico" Style="{StaticResource GhostButton}" DockPanel.Dock="Right"
                                Click="OpenLogs_Click" VerticalAlignment="Top"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource Muted}" Width="56"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
