<Window x:Class="Jinky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Jinky"
        Title="Jinky" Width="1000" Height="720" MinWidth="820" MinHeight="560"
        Background="{StaticResource Ground}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Body}" FontSize="14" FontWeight="Medium"
        Icon="Assets/tile-256.png" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Left menu: brand, pages, status and version at the bottom ============ -->
        <Border Background="#0A0D14" BorderBrush="#151A26" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22,16,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                    <Image Source="Assets/tile-256.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image Source="Assets/wordmark-white.png" Height="19" Margin="12,0,0,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>

                <!-- Bottom: what the PC is doing now, the update offer and the version -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                            Content="{Binding UpdateButtonText}" IsEnabled="{Binding CanInstallUpdate}" Click="Update_Click"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding UpdateNotes}" local:Motion.Reveal="True"/>
                    <Border CornerRadius="10" Padding="12,10" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#10141F"/>
                                <Setter Property="BorderBrush" Value="#1C2131"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Current}" Value="{x:Static local:MainViewModel+State.Streaming}">
                                        <Setter Property="Background" Value="{StaticResource GoodBg}"/>
                                        <Setter Property="BorderBrush" Value="#1F5A43"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Current}" Value="{x:Static local:MainViewModel+State.Failed}">
                                        <Setter Property="Background" Value="{StaticResource WarnBg}"/>
                                        <Setter Property="BorderBrush" Value="#5A4520"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Current}" Value="{x:Static local:MainViewModel+State.Streaming}">
                                                <Setter Property="Fill" Value="{StaticResource Good}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Current}" Value="{x:Static local:MainViewModel+State.Failed}">
                                                <Setter Property="Fill" Value="{StaticResource Warn}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding VersionText}" DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="11"
                                       Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PillText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Soft}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Content="Início" Tag="{StaticResource IcoHome}"
                                 IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavGames" Style="{StaticResource Nav}" Content="Jogos" Tag="{StaticResource IcoPad}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTvs" Style="{StaticResource Nav}" Content="TVs" Tag="{StaticResource IcoTv}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSystem" Style="{StaticResource Nav}" Content="Sistema" Tag="{StaticResource IcoSystem}" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Pages ============ -->
        <Grid Grid.Column="1">
            <!-- A faint blue glow behind the top, like the TV's home -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.2,0" GradientOrigin="0.2,0" RadiusX="0.75" RadiusY="0.5">
                        <GradientStop Color="#1C2856D9" Offset="0"/>
                        <GradientStop Color="#002856D9" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,30,40,36" MaxWidth="820">
                    <TextBlock x:Name="PageTitle" Text="Início" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="ExtraBold"/>

                    <!-- Pairing request (on every page): a new TV shows a code; approve it here if it matches -->
                    <Border CornerRadius="14" Padding="22,20" Margin="0,20,0,0" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            Visibility="{Binding HasPairing, Converter={StaticResource BoolToVisibility}}" local:Motion.Reveal="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1C2F66" Offset="0"/>
                                <GradientStop Color="#10141F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock FontFamily="{StaticResource Display}" FontSize="19" FontWeight="ExtraBold" TextWrapping="Wrap">
                                    <Run Text="{Binding Pairing.Name, Mode=OneWay}"/><Run Text=" quer se conectar"/>
                                </TextBlock>
                                <TextBlock Text="Confira se a TV mostra o mesmo código." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,10"/>
                                <TextBlock Text="{Binding PairingCode}" FontFamily="{StaticResource Mono}" FontSize="36" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Recusar" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Padding="20,11" Click="RejectPairing_Click"/>
                                <Button Content="Permitir" Style="{StaticResource PrimaryButton}" Click="AcceptPairing_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="Pages">
                        <!-- == Início == -->
                        <StackPanel x:Name="PageHome">
                            <!-- What is happening now; the live numbers only while a TV plays -->
                            <Border CornerRadius="16" BorderBrush="#1C2131" BorderThickness="1" Margin="0,20,0,0" Padding="26,24">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#16234A" Offset="0"/>
                                        <GradientStop Color="#10141F" Offset="0.65"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Text="{Binding StatusTitle}" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="ExtraBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Muted}" FontSize="13.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <UniformGrid Columns="4" Margin="0,20,-10,0" local:Motion.Reveal="True"
                                                 Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}">
                                        <Border Style="{StaticResource Tile}">
                                            <StackPanel>
                                                <TextBlock Text="LATÊNCIA" Style="{StaticResource Eyebrow}"/>
                                                <TextBlock Text="{Binding Latency}" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Tile}">
                                            <StackPanel>
                                                <TextBlock Text="IMAGEM" Style="{StaticResource Eyebrow}"/>
                                                <TextBlock Text="{Binding Fps}" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Tile}">
                                            <StackPanel>
                                                <TextBlock Text="VÍDEO" Style="{StaticResource Eyebrow}"/>
                                                <TextBlock Text="{Binding Bitrate}" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Tile}">
                                            <StackPanel>
                                                <TextBlock Text="CODEC" Style="{StaticResource Eyebrow}"/>
                                                <TextBlock Text="{Binding Codec}" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- No TV yet: the one thing to do -->
                            <local:SettingCard Header="Conecte uma TV" Icon="{StaticResource IcoTv}" Margin="0,12,0,0"
                                               Description="Abra o Jinky na TV: ela mostra um código para você confirmar aqui."
                                               Visibility="{Binding NoPairedTvs, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Instalar numa TV" Style="{StaticResource GhostButton}" Click="GoTvs_Click"/>
                            </local:SettingCard>

                            <DockPanel Margin="0,22,0,10">
                                <Button Content="Pasta de diagnóstico" Style="{StaticResource GhostButton}" DockPanel.Dock="Right"
                                        Padding="12,5" FontSize="12" Click="OpenLogs_Click"/>
                                <TextBlock Text="Atividade recente" Style="{StaticResource Section}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Background="#10141F" BorderBrush="#1C2131" BorderThickness="1" CornerRadius="10" Padding="18,10">
                                <ItemsControl ItemsSource="{Binding Activity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,5">
                                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Dim}"
                                                           Width="52" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Soft}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- == Jogos == -->
                        <StackPanel x:Name="PageGames" Visibility="Collapsed">
                            <TextBlock Text="Ao jogar na TV" Style="{StaticResource Section}"/>
                            <local:SettingCard Header="Modo console" Icon="{StaticResource IcoPad}"
                                               Description="Steam Big Picture e monitor a 60 Hz durante a sessão; tudo volta ao normal no fim.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ConsoleMode}"/>
                            </local:SettingCard>
                            <StackPanel Visibility="{Binding ConsoleMode, Converter={StaticResource BoolToVisibility}}" local:Motion.Reveal="True" Margin="32,0,0,0">
                                <local:SettingCard Style="{StaticResource SubCard}" Header="Limitar jogos a 60 fps"
                                                   Description="A TV mostra 60 quadros; o resto só pesa na placa de vídeo."
                                                   ToolTip="Usa o limite do driver da NVIDIA e volta ao seu ajuste quando você sai.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CapGames}"/>
                                </local:SettingCard>
                                <local:SettingCard Style="{StaticResource SubCard}" Header="Abrir jogos pelo Big Picture"
                                                   Description="Desligado, o jogo abre direto (mais rápido) e a TV mostra o que a Steam está fazendo.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GamesInBigPicture}"/>
                                </local:SettingCard>
                                <local:SettingCard Style="{StaticResource SubCard}" Header="Deixar o Big Picture aberto"
                                                   Description="Entre uma partida e outra, os jogos abrem mais rápido."
                                                   ToolTip="Ele fecha quando você sai do Jinky. Bom para um usuário do Windows que é só console.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeepBigPicture}"/>
                                </local:SettingCard>
                            </StackPanel>
                            <local:SettingCard Header="Som só na TV" Icon="{StaticResource IcoSound}" Margin="0,8,0,4"
                                               Description="Silencia as caixas do PC enquanto a TV joga (sempre ligado no modo console)."
                                               IsEnabled="{Binding SoundToggleEnabled}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SoundOnlyOnTv}"/>
                            </local:SettingCard>
                            <local:SettingCard Header="Jinky Vision (beta)" Icon="{StaticResource IcoEye}"
                                               Description="Mais nitidez no centro da tela, onde está a ação, com a mesma banda."
                                               ToolTip="Bom para Wi-Fi e Fire Stick. As bordas ficam um pouco mais suaves; compare ligado e desligado.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Vision}"/>
                            </local:SettingCard>

                            <TextBlock Text="Biblioteca da Steam" Style="{StaticResource Section}"/>
                            <local:SettingCard Header="Ler direto da Steam" Icon="{StaticResource IcoLibrary}"
                                               Description="A TV mostra a sua biblioteca exata, com os jogos da família. Vale depois de reiniciar a Steam.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SteamDirect}"/>
                            </local:SettingCard>
                            <local:SettingCard Header="Chave da API da Steam" Icon="{StaticResource IcoKey}"
                                               Description="Conquistas e perfil na TV. Crie em steamcommunity.com/dev/apikey."
                                               Status="{Binding SteamKeyStatus}">
                                <TextBox Style="{StaticResource Field}" Width="230" Height="38"
                                         Text="{Binding SteamApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                            </local:SettingCard>
                        </StackPanel>

                        <!-- == TVs == -->
                        <StackPanel x:Name="PageTvs" Visibility="Collapsed">
                            <TextBlock Text="{Binding PairedTvsText}" Style="{StaticResource Section}"/>
                            <ItemsControl ItemsSource="{Binding PairedTvs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:SettingCard Header="{Binding Name}" Icon="{StaticResource IcoTv}" Description="Pareada com este PC">
                                            <Button Content="Remover" Style="{StaticResource GhostButton}" Tag="{Binding Id}" Click="Unpair_Click"/>
                                        </local:SettingCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <local:SettingCard Header="Instalar numa TV nova" Icon="{StaticResource IcoDownload}"
                                               Description="No app Downloader da TV, digite este endereço. Depois ela se atualiza sozinha."
                                               ToolTip="Fire TV ou Google TV: instale o app Downloader e permita que ele instale apps (&quot;Fontes desconhecidas&quot;).">
                                <TextBox Text="{Binding TvInstallUrl, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Field}"
                                         Width="290" Height="38" FontWeight="Bold"/>
                            </local:SettingCard>
                            <local:SettingCard Header="Nome deste PC na TV" Icon="{StaticResource IcoTag}" Description="{Binding TvNameHint}">
                                <TextBox Style="{StaticResource Field}" Width="230" Height="38" FontFamily="{StaticResource Body}" FontSize="13.5"
                                         Text="{Binding TvName}"/>
                            </local:SettingCard>

                            <TextBlock Text="Ligar, desligar e jogar de longe" Style="{StaticResource Section}"/>
                            <local:SettingCard Header="Ligar o PC pela TV" Icon="{StaticResource IcoMoon}"
                                               Description="Abrir o Jinky na TV acorda este PC quando ele está suspenso."
                                               ToolTip="Funciona com o PC suspenso (Suspender, ou a suspensão do Windows). Desligado de vez, não funciona pelo Wi-Fi."
                                               Status="{Binding WakeFromTvText}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WakeFromTv}"/>
                            </local:SettingCard>
                            <local:SettingCard Header="A TV pode suspender ou desligar o PC" Icon="{StaticResource IcoPower}"
                                               Description="Em Configurações › Sistema, no Jinky da TV. Só TVs pareadas podem pedir.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AllowTvPower}"/>
                            </local:SettingCard>
                            <local:SettingCard Header="Jogar fora de casa" Icon="{StaticResource IcoGlobe}"
                                               Description="A TV joga deste PC de qualquer lugar, pelo Tailscale (grátis)."
                                               ToolTip="Ao ligar, o Jinky instala o Tailscale e abre o login. Entre com a mesma conta no PC e na TV. Pareie a TV em casa primeiro."
                                               Status="{Binding RemotePlayText}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RemotePlayOn}"/>
                            </local:SettingCard>
                            <local:SettingCard Header="Monitor virtual (beta)" Icon="{StaticResource IcoScreens}"
                                               Description="O jogo vai para uma tela do tamanho da TV; o seu monitor não troca de resolução."
                                               ToolTip="Instala um driver de código aberto (Virtual Display Driver) na primeira vez. O monitor do PC fica apagado e volta como estava. Não vale para HDR."
                                               Status="{Binding VirtualDisplayText}"
                                               Visibility="{Binding VirtualDisplayAvailable, Converter={StaticResource BoolToVisibility}}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding VirtualDisplayOn}"/>
                            </local:SettingCard>
                        </StackPanel>

                        <!-- == Sistema == -->
                        <StackPanel x:Name="PageSystem" Visibility="Collapsed">
                            <TextBlock Text="Geral" Style="{StaticResource Section}"/>
                            <local:SettingCard Header="Iniciar com o Windows" Icon="{StaticResource IcoStart}"
                                               Description="O Jinky fica perto do relógio, sempre pronto para a TV.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}"/>
                            </local:SettingCard>

                            <TextBlock Text="Atualizações" Style="{StaticResource Section}"/>
                            <local:SettingCard Icon="{StaticResource IcoUpdate}" Header="{Binding VersionTitle}" Description="{Binding UpdateCheckText}">
                                <Button Content="Procurar atualização" Style="{StaticResource GhostButton}" Click="CheckUpdates_Click"/>
                            </local:SettingCard>
                            <!-- Only on the developer's PC (a "developer" file in Jinky's data folder). -->
                            <local:SettingCard Header="Receber versões de teste" Icon="{StaticResource IcoFlask}"
                                               Description="Este PC e as TVs dele recebem as versões novas antes de todo mundo."
                                               Visibility="{Binding ShowTestUpdates, Converter={StaticResource BoolToVisibility}}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TestUpdates}"/>
                            </local:SettingCard>

                            <TextBlock Text="Este PC" Style="{StaticResource Section}"/>
                            <Border Background="#10141F" BorderBrush="#1C2131" BorderThickness="1" CornerRadius="10" Padding="18,14">
                                <Grid TextBlock.FontSize="13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Placa de vídeo" Foreground="{StaticResource Muted}" Margin="0,0,16,9"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Gpu}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="Tela capturada" Foreground="{StaticResource Muted}" Margin="0,0,16,9"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Desktop}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                               FontFamily="{StaticResource Mono}" FontSize="12"/>
                                    <TextBlock Grid.Row="2" Text="Controle virtual" Foreground="{StaticResource Muted}" Margin="0,0,16,9"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GamepadDriver}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Text="Controles conectados" Foreground="{StaticResource Muted}" Margin="0,0,16,9"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PadsConnected}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource Mono}" FontSize="12"/>
                                    <TextBlock Grid.Row="4" Text="Portas" Foreground="{StaticResource Muted}" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PortsText}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource Mono}" FontSize="12"/>
                                </Grid>
                            </Border>
                            <local:SettingCard Header="Diagnóstico" Icon="{StaticResource IcoFolder}" Margin="0,4,0,0"
                                               Description="Os registros do Jinky, para resolver problemas.">
                                <Button Content="Abrir pasta" Style="{StaticResource GhostButton}" Click="OpenLogs_Click"/>
                            </local:SettingCard>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
