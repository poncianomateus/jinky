<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (tray) lives in Windows Forms. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Jinky</AssemblyName>
    <RootNamespace>Jinky</RootNamespace>
    <ApplicationIcon>Assets\jinky.ico</ApplicationIcon>
    <!-- One version for the whole product: repo-root VERSION. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</Version>
    <Product>Jinky</Product>
    <Description>Jinky — jogue os jogos do PC na TV</Description>
    <!-- Everything the user runs ends up in build\app next to the engine. -->
    <OutputPath>..\..\build\app\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its names out of the global usings (WPF clash). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\tile-256.png" />
    <Resource Include="Assets\wordmark-white.png" />
    <!-- Montserrat and JetBrains Mono (OFL), static cuts made by tools/branding/make_logos.py. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <Content Include="Assets\Fonts\OFL-*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\jinky.ico" Link="jinky.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The C++ streaming engine (built by host/engine) ships next to Jinky.exe. -->
    <None Include="..\..\build\host\Release\jinky-engine.exe" Link="jinky-engine.exe"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\build\host\Release\jinky-engine.exe')" />
    <!-- The TV app of this same version, served to the TVs for updates (TvUpdateServer). -->
    <None Include="..\..\tv\app\build\outputs\apk\release\app-release.apk" Link="tv\jinky-tv.apk"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\tv\app\build\outputs\apk\release\app-release.apk')" />
  </ItemGroup>

</Project>
