<Application x:Class="Jinky.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Jinky"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Jinky v2 palette (same tokens as the TV app: Theme.kt) -->
        <Color x:Key="InkColor">#07090D</Color>
        <Color x:Key="BlueColor">#4F8BFF</Color>
        <SolidColorBrush x:Key="Ground" Color="#07090D"/>
        <SolidColorBrush x:Key="Surface" Color="#10141F"/>
        <SolidColorBrush x:Key="Raised" Color="#171C2A"/>
        <SolidColorBrush x:Key="Line" Color="#23283A"/>
        <SolidColorBrush x:Key="Text" Color="#F5F7FC"/>
        <SolidColorBrush x:Key="Soft" Color="#C8CFDF"/>
        <SolidColorBrush x:Key="Muted" Color="#A6AEC2"/>
        <SolidColorBrush x:Key="Dim" Color="#7F889E"/>
        <SolidColorBrush x:Key="Accent" Color="#4F8BFF"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#8DB3FF"/>
        <SolidColorBrush x:Key="AccentDeep" Color="#2856D9"/>
        <SolidColorBrush x:Key="Ink" Color="#07090D"/>
        <SolidColorBrush x:Key="Good" Color="#3DDC97"/>
        <SolidColorBrush x:Key="GoodBg" Color="#0F2A20"/>
        <SolidColorBrush x:Key="Warn" Color="#FFB547"/>
        <SolidColorBrush x:Key="WarnBg" Color="#2E2410"/>

        <!-- Montserrat for words, JetBrains Mono for numbers (static cuts in Assets/Fonts) -->
        <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Montserrat</FontFamily>
        <FontFamily x:Key="Body">pack://application:,,,/Assets/Fonts/#Montserrat</FontFamily>
        <FontFamily x:Key="Mono">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!-- Section title with the brand's blue pixel in front -->
        <Style x:Key="CardTitle" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,1,10,0"/>
                            <TextBlock Text="{TemplateBinding Header}" FontFamily="{StaticResource Display}" FontSize="16"
                                       FontWeight="Bold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small uppercase label (eyebrows, stat names) -->
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Raised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <local:NonEmptyToVisibility x:Key="NonEmptyToVisibility"/>

        <!-- Line icons, 20x20, drawn with a stroke (Path Stretch=None) -->
        <Geometry x:Key="IcoHome">M3,9.5 L10,3.5 L17,9.5 M5,8 V16.5 H15 V8</Geometry>
        <Geometry x:Key="IcoPad">M6.5,6.5 H13.5 C16,6.5 17.8,8.8 18.3,12 C18.7,14.6 17,16 15.2,14.6 L13.4,13 H6.6 L4.8,14.6 C3,16 1.3,14.6 1.7,12 C2.2,8.8 4,6.5 6.5,6.5 Z M6,8.75 V11.25 M4.75,10 H7.25 M13.2,9.4 V9.4 M14.8,10.8 V10.8</Geometry>
        <Geometry x:Key="IcoTv">M2.5,4 H17.5 V14 H2.5 Z M7,17 H13</Geometry>
        <Geometry x:Key="IcoSystem">M3,6 H17 M3,14 H17 M7,3.5 V8.5 M13,11.5 V16.5</Geometry>
        <Geometry x:Key="IcoGauge">M3,14.5 A7,7 0 1 1 17,14.5 M10,14.5 L13,9.5</Geometry>
        <Geometry x:Key="IcoGrid">M2.5,4.5 H17.5 V15.5 H2.5 Z M5.5,8 H9.5 V12 H5.5 Z M12,8 H14.5 M12,10 H14.5 M12,12 H14.5</Geometry>
        <Geometry x:Key="IcoPin">M7,2.5 H13 L12,8 L15,11 H5 L8,8 Z M10,11 V17.5</Geometry>
        <Geometry x:Key="IcoEye">M1.5,10 C4,5.5 7,4 10,4 C13,4 16,5.5 18.5,10 C16,14.5 13,16 10,16 C7,16 4,14.5 1.5,10 Z M10,7.5 A2.5,2.5 0 1 1 10,12.5 A2.5,2.5 0 1 1 10,7.5 Z</Geometry>
        <Geometry x:Key="IcoSound">M3,8 H6 L10,4.5 V15.5 L6,12 H3 Z M13,7.5 C14.3,8.8 14.3,11.2 13,12.5 M15.5,5.5 C18,8 18,12 15.5,14.5</Geometry>
        <Geometry x:Key="IcoPower">M10,2.5 V9 M6,5 C3.5,6.5 2.5,9.5 3.5,12.5 C4.5,15.3 7,17 10,17 C13,17 15.5,15.3 16.5,12.5 C17.5,9.5 16.5,6.5 14,5</Geometry>
        <Geometry x:Key="IcoMoon">M15.5,12.5 C12,13.5 8,11 7.5,7 C7.3,5.5 7.6,4.2 8.3,3 C4.8,3.8 2.5,7 3,10.6 C3.5,14.4 7,17.2 10.8,16.8 C13,16.6 14.6,15.5 15.5,12.5 Z</Geometry>
        <Geometry x:Key="IcoGlobe">M10,2.5 A7.5,7.5 0 1 1 10,17.5 A7.5,7.5 0 1 1 10,2.5 Z M2.5,10 H17.5 M10,2.5 C7.5,5 7.5,15 10,17.5 M10,2.5 C12.5,5 12.5,15 10,17.5</Geometry>
        <Geometry x:Key="IcoScreens">M2,3.5 H12.5 V10.5 H2 Z M7.5,8 H18 V15.5 H7.5 Z</Geometry>
        <Geometry x:Key="IcoStart">M3,3 H9 V9 H3 Z M11,3 H17 V9 H11 Z M3,11 H9 V17 H3 Z M11,11 H17 V17 H11 Z</Geometry>
        <Geometry x:Key="IcoUpdate">M16,10 A6,6 0 1 1 13.5,5.2 M14,1.8 V5.5 H10.3</Geometry>
        <Geometry x:Key="IcoFlask">M7.5,2.5 H12.5 M8.5,2.5 V8 L4,16 C3.6,16.8 4,17.5 5,17.5 H15 C16,17.5 16.4,16.8 16,16 L11.5,8 V2.5 M5.8,13 H14.2</Geometry>
        <Geometry x:Key="IcoFolder">M2.5,5 C2.5,4 3,3.5 4,3.5 H8 L10,5.5 H16 C17,5.5 17.5,6 17.5,7 V15 C17.5,16 17,16.5 16,16.5 H4 C3,16.5 2.5,16 2.5,15 Z</Geometry>
        <Geometry x:Key="IcoKey">M7,6 A3.5,3.5 0 1 1 7,13 A3.5,3.5 0 1 1 7,6 Z M10.5,9.5 H17.5 M15,9.5 V12.5 M17.5,9.5 V11.5</Geometry>
        <Geometry x:Key="IcoTag">M3,3 H10 L17,10 L10,17 L3,10 Z M6.5,6.5 V6.5</Geometry>
        <Geometry x:Key="IcoDownload">M10,3 V12.5 M6,9 L10,13 L14,9 M3.5,16.5 H16.5</Geometry>
        <Geometry x:Key="IcoChip">M5,5 H15 V15 H5 Z M8,8 H12 V12 H8 Z M8,2.5 V5 M12,2.5 V5 M8,15 V17.5 M12,15 V17.5 M2.5,8 H5 M2.5,12 H5 M15,8 H17.5 M15,12 H17.5</Geometry>
        <Geometry x:Key="IcoLibrary">M3.5,3.5 V16.5 M7.5,3.5 V16.5 M11,4.5 L15.5,16</Geometry>
        <Geometry x:Key="IcoPulse">M2,10 H6 L8,5 L12,15 L14,10 H18</Geometry>

        <!-- Switch: the thumb slides and the track fills with blue (animated), white ring for keyboard focus -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="Ring" Grid.Column="1" CornerRadius="15" Padding="2" BorderThickness="2" BorderBrush="Transparent"
                                    VerticalAlignment="Center">
                                <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="TrackFill" Color="#1A2030"/>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <SolidColorBrush x:Name="TrackEdge" Color="#3A4157"/>
                                    </Border.BorderBrush>
                                    <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush x:Name="ThumbFill" Color="#A6AEC2"/>
                                        </Ellipse.Fill>
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="Slide" X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="TrackFill" Storyboard.TargetProperty="Color" To="#4F8BFF" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="TrackEdge" Storyboard.TargetProperty="Color" To="#4F8BFF" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="ThumbFill" Storyboard.TargetProperty="Color" To="White" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="TrackFill" Storyboard.TargetProperty="Color" To="#1A2030" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="TrackEdge" Storyboard.TargetProperty="Color" To="#3A4157" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="ThumbFill" Storyboard.TargetProperty="Color" To="#A6AEC2" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A setting: icon, title, one line, the control on the right. Lights up a little under the mouse. -->
        <Style TargetType="local:SettingCard">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SettingCard">
                        <Border x:Name="Card" CornerRadius="10" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush x:Name="CardFill" Color="#10141F"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="CardEdge" Color="#1C2131"/>
                            </Border.BorderBrush>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Glyph" Data="{TemplateBinding Icon}" Width="20" Height="20" Stretch="None" Margin="0,0,16,0"
                                      Stroke="{StaticResource Soft}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{TemplateBinding Description}" Foreground="{StaticResource Muted}" FontSize="12.5"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NonEmptyToVisibility}}"/>
                                    <TextBlock Text="{TemplateBinding Status}" Foreground="{StaticResource AccentSoft}" FontSize="12.5"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding Status, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NonEmptyToVisibility}}"/>
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="CardFill" Storyboard.TargetProperty="Color" To="#151A28" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="CardEdge" Storyboard.TargetProperty="Color" To="#2A3146" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="CardFill" Storyboard.TargetProperty="Color" To="#10141F" Duration="0:0:0.25"/>
                                            <ColorAnimation Storyboard.TargetName="CardEdge" Storyboard.TargetProperty="Color" To="#1C2131" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A sub-option, tucked under its parent setting -->
        <Style x:Key="SubCard" TargetType="local:SettingCard" BasedOn="{StaticResource {x:Type local:SettingCard}}">
            <Setter Property="Padding" Value="18,12"/>
        </Style>

        <!-- Section title above a group of cards -->
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="2,22,0,10"/>
        </Style>

        <!-- Left menu entry: icon + name; a blue bar grows in front of the open page -->
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Pad" CornerRadius="8" Padding="12,10">
                                <Border.Background>
                                    <SolidColorBrush x:Name="PadFill" Color="#00171C2A"/>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="Glyph" Data="{TemplateBinding Tag}" Width="20" Height="20" Stretch="None" Margin="0,0,14,0"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Rectangle x:Name="Bar" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Accent}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="BarScale" ScaleY="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter TargetName="Pad" Property="Background" Value="#10141F"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pad" Property="BorderBrush" Value="{StaticResource Text}"/>
                                <Setter TargetName="Pad" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="Pad" Property="Background" Value="#171C2A"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action: white pill with ink text (the console's focus look) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" CornerRadius="23" Padding="2" BorderThickness="2" BorderBrush="Transparent">
                            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="White"/>
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Blue pill (the update offer) -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" CornerRadius="21" Padding="2" BorderThickness="2" BorderBrush="Transparent">
                            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M5,0 L5,7 M1.5,4 L5,7.5 L8.5,4 M0,10.5 L10,10.5" Stroke="White" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#6A9DFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet pill on the dark cards -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Soft}"/>
            <Setter Property="Background" Value="{StaticResource Raised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="17" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1F2536"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource Text}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Text}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text field on the dark cards -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="{StaticResource Ground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#3A4157"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim dark scroll bar (the window scrolls on small screens) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4,3,4">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Background="#2A3042" CornerRadius="4"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="#3A4157"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource Raised}"/>
            <Setter Property="Foreground" Value="{StaticResource Soft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Application.Resources>
</Application>
